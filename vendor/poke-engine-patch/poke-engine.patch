+    /// Plays one turn (outcome sampled by its probability); returns winner().
+    fn step(&mut self, index: usize, a1: usize, a2: usize) -> PyResult<f32> {
+        use rand::Rng;
+        let state = &mut self.states[index];
+        let (s1, s2) = state.root_get_all_options();
