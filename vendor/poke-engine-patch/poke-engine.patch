+#[pyclass(name = "Env")]
+pub struct PyEnv {
+    states: Vec<State>,
+    rng: rand::rngs::StdRng,
+}
+
+#[pymethods]
+impl PyEnv {
+    #[new]
+    #[pyo3(signature = (states, seed=0))]
+    fn new(states: Vec<String>, seed: u64) -> PyResult<Self> {
+        use rand::SeedableRng;
+        let states = states.iter().map(|s| State::deserialize(s)).collect();
+        Ok(PyEnv { states, rng: rand::rngs::StdRng::seed_from_u64(seed) })
+    }
+
+    fn __len__(&self) -> usize {
+        self.states.len()
+    }
+
+    fn reset(&mut self, index: usize, state: String) {
+        self.states[index] = State::deserialize(&state);
+    }
+
+    fn serialize(&self, index: usize) -> String {
+        self.states[index].serialize()
+    }
+
+    /// Legal action mask (15 slots) for each side.
+    fn masks(&self, index: usize) -> (Vec<bool>, Vec<bool>) {
+        let (s1, s2) = self.states[index].root_get_all_options();
+        let mut m1 = vec![false; ACTION_SLOTS];
+        let mut m2 = vec![false; ACTION_SLOTS];
+        for c in s1.iter() { if let Some(i) = choice_slot(c) { m1[i] = true; } }
+        for c in s2.iter() { if let Some(i) = choice_slot(c) { m2[i] = true; } }
+        (m1, m2)
+    }
+
+
+    /// (ints, mon_floats, global_floats) for `perspective` (1 or 2), flattened.
+    fn observe(&self, index: usize, perspective: u8) -> (Vec<i32>, Vec<f32>, Vec<f32>) {
+        let st = &self.states[index];
+        let (me, foe) = if perspective == 2 { (&st.side_two, &st.side_one) } else { (&st.side_one, &st.side_two) };
+        let mut ints = Vec::with_capacity(12 * OBS_INTS_PER_MON + 2);
+        let mut mons = Vec::with_capacity(12 * OBS_FLOATS_PER_MON);
+        for side in [me, foe] {
+            let ord = order(side);
+            for (k, i) in ord.iter().enumerate() {
+                encode_mon(&side.pokemon.pkmn[*i], k == 0, &mut ints, &mut mons);
+            }
+        }
+        ints.push(st.weather.weather_type.clone() as i32);
+        ints.push(st.terrain.terrain_type.clone() as i32);
+        let mut glob = Vec::with_capacity(OBS_GLOBAL_FLOATS);
+        encode_side_globals(me, &mut glob);
+        encode_side_globals(foe, &mut glob);
+        assert_eq!(glob.len(), OBS_GLOBAL_FLOATS);
+        (ints, mons, glob)
+    }
+
+    /// Slot -> team position map for switches seen from `perspective`: the
+    /// observation orders the team active-first, the action slots use engine indices.
+    fn switch_order(&self, index: usize, perspective: u8) -> Vec<usize> {
+        let st = &self.states[index];
+        let side = if perspective == 2 { &st.side_two } else { &st.side_one };
+        order(side).to_vec()
+    }
+
+
+    /// Every battle, both perspectives (env 0 side 1, env 0 side 2, env 1 side 1, ...),
+    /// as raw little-endian buffers: (ints i32, mon floats f32, global floats f32,
+    /// switch order i64, masks u8). Python wraps them with numpy.frombuffer.
+    fn observe_all<'py>(&self, py: Python<'py>) -> (Bound<'py, pyo3::types::PyBytes>, Bound<'py, pyo3::types::PyBytes>,
+            Bound<'py, pyo3::types::PyBytes>, Bound<'py, pyo3::types::PyBytes>, Bound<'py, pyo3::types::PyBytes>) {
+        let n = self.states.len() * 2;
+        let mut ints: Vec<u8> = Vec::with_capacity(n * 122 * 4);
+        let mut mons: Vec<u8> = Vec::with_capacity(n * 12 * OBS_FLOATS_PER_MON * 4);
+        let mut glob: Vec<u8> = Vec::with_capacity(n * OBS_GLOBAL_FLOATS * 4);
+        let mut ord: Vec<u8> = Vec::with_capacity(n * 6 * 8);
+        let mut masks: Vec<u8> = Vec::with_capacity(n * ACTION_SLOTS);
+        for index in 0..self.states.len() {
+            let (m1, m2) = self.masks(index);
+            for perspective in [1u8, 2u8] {
+                let (i, m, g) = self.observe(index, perspective);
+                for v in i { ints.extend_from_slice(&v.to_le_bytes()); }
+                for v in m { mons.extend_from_slice(&v.to_le_bytes()); }
+                for v in g { glob.extend_from_slice(&v.to_le_bytes()); }
+                for v in self.switch_order(index, perspective) { ord.extend_from_slice(&(v as i64).to_le_bytes()); }
+                for v in if perspective == 1 { &m1 } else { &m2 } { masks.push(*v as u8); }
+            }
+        }
+        (pyo3::types::PyBytes::new(py, &ints), pyo3::types::PyBytes::new(py, &mons), pyo3::types::PyBytes::new(py, &glob),
+         pyo3::types::PyBytes::new(py, &ord), pyo3::types::PyBytes::new(py, &masks))
+    }
+
+    /// One turn in every battle: actions[2i] for side one, actions[2i+1] for side two.
+    fn step_all(&mut self, actions: Vec<usize>) -> PyResult<Vec<f32>> {
+        let mut out = Vec::with_capacity(self.states.len());
+        for index in 0..self.states.len() {
+            out.push(self.step(index, actions[2 * index], actions[2 * index + 1])?);
+        }
+        Ok(out)
+    }
+
+
+    /// Slot chosen by poke-engine's own MCTS (perfect information) for `side`:
+    /// the benchmark opponent for the network.
+    fn mcts_action(&self, index: usize, side: u8, iterations: u32) -> usize {
+        let mut state = self.states[index].clone();
+        let (s1, s2) = state.root_get_all_options();
+        let result = poke_engine::mcts::perform_mcts(&mut state, s1, s2, Duration::from_secs(30), iterations);
+        let options = if side == 2 { result.s2 } else { result.s1 };
+        let best = options.iter().max_by_key(|o| o.visits).map(|o| o.move_choice.clone());
+        best.and_then(|c| choice_slot(&c)).unwrap_or(14)
+    }
+
+
+    /// MCTS visit share per action slot (15) for both sides: the search policy
+    /// the network learns to imitate (expert iteration).
+    fn mcts_policy(&self, index: usize, iterations: u32) -> (Vec<f32>, Vec<f32>) {
+        let mut state = self.states[index].clone();
+        let (s1, s2) = state.root_get_all_options();
+        let result = poke_engine::mcts::perform_mcts(&mut state, s1, s2, Duration::from_secs(30), iterations);
+        let share = |side: &Vec<poke_engine::mcts::MctsSideResult>| {
+            let total: u32 = side.iter().map(|o| o.visits).sum::<u32>().max(1);
+            let mut out = vec![0.0f32; ACTION_SLOTS];
+            for o in side.iter() {
+                if let Some(slot) = choice_slot(&o.move_choice) { out[slot] += o.visits as f32 / total as f32; }
+            }
+            out
+        };
+        (share(&result.s1), share(&result.s2))
+    }
+
+
+    /// (slot, Foul Play-format name) of every legal option for `side`, e.g.
+    /// (4, "earthquake-tera") or (9, "switch gliscor").
+    fn option_names(&self, index: usize, side: u8) -> Vec<(usize, String)> {
+        let state = &self.states[index];
+        let (s1, s2) = state.root_get_all_options();
+        let (options, own) = if side == 2 { (s2, &state.side_two) } else { (s1, &state.side_one) };
+        options.iter().filter_map(|c| choice_slot(c).map(|slot| (slot, movechoice_to_string(own, c)))).collect()
+    }
