+    pub fn regret_matching_for_side(
+        &self,
+        side_map: &[MoveNode],
+        c: f32,
+        rng: &mut impl Rng,
+    ) -> usize {
+        let (total, visits) = side_map
+            .iter()
+            .fold((0.0f32, 0u32), |(t, v), n| (t + n.total_score, v + n.visits));
