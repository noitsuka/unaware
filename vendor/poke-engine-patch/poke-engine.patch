+// Observation for the network, from one player's point of view (perspective 1 or 2).
+// ints: 12 Pokémon (own then foe, own active first) x 10 ids
+//       [species, type1, type2, tera_type, item, ability, move0..move3] + [weather, terrain]
+// mon floats: 12 x 48; global floats: 40.
+pub const OBS_INTS_PER_MON: usize = 10;
+pub const OBS_FLOATS_PER_MON: usize = 48;
+pub const OBS_GLOBAL_FLOATS: usize = 40;
+
+fn order(side: &Side) -> [usize; 6] {
+    let active = side.active_index as usize;
+    let mut out = [active, 0, 0, 0, 0, 0];
+    let mut k = 1;
+    for i in 0..6 { if i != active { out[k] = i; k += 1; } }
+    out
+}
+
+fn encode_mon(p: &Pokemon, active: bool, ints: &mut Vec<i32>, floats: &mut Vec<f32>) {
+    let moves = [&p.moves.m0, &p.moves.m1, &p.moves.m2, &p.moves.m3];
+    ints.push(p.id.clone() as i32);
+    ints.push(p.types.0.clone() as i32);
+    ints.push(p.types.1.clone() as i32);
+    ints.push(p.tera_type.clone() as i32);
+    ints.push(p.item.clone() as i32);
+    ints.push(p.ability.clone() as i32);
+    for m in moves.iter() { ints.push(m.id.clone() as i32); }
+    let alive = p.hp > 0;
+    floats.push(if p.maxhp > 0 { p.hp.max(0) as f32 / p.maxhp as f32 } else { 0.0 });
+    floats.push(alive as i32 as f32);
+    floats.push(active as i32 as f32);
+    floats.push(p.terastallized as i32 as f32);
+    let status = p.status.clone() as usize;
+    for k in 0..7 { floats.push((status == k) as i32 as f32); }
+    for stat in [p.attack, p.defense, p.special_attack, p.special_defense, p.speed] { floats.push(stat as f32 / 500.0); }
+    for m in moves.iter() { floats.push((m.pp.max(0) as f32 / 32.0).min(1.0)); }
+    for m in moves.iter() { floats.push(m.disabled as i32 as f32); }
+    for m in moves.iter() {
+        let c = &m.choice;
+        floats.push(c.base_power / 150.0);
+        floats.push(c.accuracy / 100.0);
+        let cat = c.category.clone() as usize;
+        for k in 0..3 { floats.push((cat == k) as i32 as f32); }
+        floats.push(c.priority as f32 / 3.0);
+    }
+}
+
+fn encode_side_globals(side: &Side, floats: &mut Vec<f32>) {
+    for b in [side.attack_boost, side.defense_boost, side.special_attack_boost, side.special_defense_boost,
+              side.speed_boost, side.accuracy_boost, side.evasion_boost] { floats.push(b as f32 / 6.0); }
+    let sc = &side.side_conditions;
+    floats.push(sc.stealth_rock as f32);
+    floats.push(sc.spikes as f32 / 3.0);
+    floats.push(sc.toxic_spikes as f32 / 2.0);
+    floats.push(sc.sticky_web as f32);
+    floats.push((sc.reflect > 0) as i32 as f32);
+    floats.push((sc.light_screen > 0) as i32 as f32);
+    floats.push((sc.aurora_veil > 0) as i32 as f32);
+    floats.push((sc.tailwind > 0) as i32 as f32);
+    floats.push(sc.toxic_count as f32 / 16.0);
+    floats.push((side.substitute_health > 0) as i32 as f32);
+    floats.push(side.force_switch as i32 as f32);
+    let used_tera = side.pokemon.pkmn.iter().any(|p| p.terastallized);
+    floats.push(used_tera as i32 as f32);
+    floats.push((side.wish.0 > 0) as i32 as f32);
+    // 7 boosts + 9 side conditions + 4 flags = 20 per side
+}
+
+// ---- Self-play environment (unaware neural training) -------------------
+// Battles live in Rust; Python only sees action slots:
+// 0-3 Move(i), 4-7 MoveTera(i), 8-13 Switch(p), 14 None.
+const ACTION_SLOTS: usize = 15;
+
+fn choice_slot(choice: &MoveChoice) -> Option<usize> {
+    match choice {
+        MoveChoice::Move(i) => Some(*i as usize),
+        MoveChoice::MoveTera(i) => Some(4 + *i as usize),
+        MoveChoice::Switch(p) => Some(8 + *p as usize),
+        MoveChoice::None => Some(14),
+        _ => None,
+    }
+}
+
+fn slot_choice(options: &[MoveChoice], slot: usize) -> Option<MoveChoice> {
+    options.iter().find(|c| choice_slot(c) == Some(slot)).cloned()
+}
